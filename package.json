{
  "name": "collaboration-product",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc --noEmit && npm run build -w @collab/ui",
    "test": "npm run test --workspaces --if-present",
    "verify:pins": "node --import tsx tools/verify-pins.ts",
    "verify:zero-call": "node --import tsx tools/verify-zero-call.ts",
    "doctor": "node --import tsx tools/doctor.ts",
    "login:claude": "node --import tsx tools/claude-login.ts",
    "start": "node --import tsx packages/service/src/cli.ts",
    "report:overhead": "node --import tsx tools/report-overhead.ts",
    "soak": "PLAYWRIGHT_BROWSERS_PATH=.playwright node --import tsx tools/soak.ts",
    "canary": "node --import tsx tools/canary.ts",
    "verify:all": "node --import tsx tools/run-all.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.220",
    "preact": "10.27.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.55.1",
    "@testing-library/preact": "3.2.4",
    "@types/node": "22.18.6",
    "@preact/preset-vite": "2.10.2",
    "axe-core": "4.10.3",
    "jsdom": "27.0.0",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vite": "7.1.7",
    "vitest": "3.2.4"
  }
}
